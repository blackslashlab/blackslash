---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import Badge from '../../components/ui/Badge.astro';
import ProductFeatures from '../../components/products/ProductFeatures.astro';
import ProductSpecifications from '../../components/products/ProductSpecifications.astro';
import ProductDownloads from '../../components/products/ProductDownloads.astro';

export async function getStaticPaths() {
  const products = await getCollection('products');
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

const { product } = Astro.props;
const { data } = product;
---

<Layout title={data.seo.title} description={data.seo.description}>
  <!-- Product Header -->
  <section class="bg-primary-gray-50 py-16 md:py-24">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <!-- Product Info -->
        <div>
          <div class="flex items-center gap-3 mb-4">
            <span class="w-8 h-px bg-primary-accent"></span>
            <Badge variant="gray">{data.category}</Badge>
          </div>
          
          <h1 class="heading-2 mb-4">
            {data.name}
          </h1>
          
          <p class="body-large mb-8">
            {data.description}
          </p>
          
          <!-- Quick Features -->
          <div class="space-y-3">
            {data.features.slice(0, 3).map((feature) => (
              <div class="flex items-center gap-3">
                <svg class="w-5 h-5 text-primary-accent flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                </svg>
                <span class="text-sm text-primary-gray-700">{feature.title}</span>
              </div>
            ))}
          </div>
          
          <!-- CTAs -->
          <div class="mt-8 flex flex-col sm:flex-row gap-4">
            <a href="/contact" class="btn-primary">
              Request Quote
              <svg class="w-4 h-4 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
            <a href="/contact" class="btn-secondary">
              Contact Sales
            </a>
          </div>
        </div>
        
        <!-- Product Image -->
        <div class="relative">
          <div class="aspect-square bg-white rounded-2xl border border-primary-gray-200 p-8 relative overflow-hidden">
            <img
              src={data.image}
              alt={data.name}
              class="w-full h-full object-contain"
              loading="lazy"
            />
            
            <!-- Decorative elements -->
            <div class="absolute top-4 right-4 w-8 h-8 border border-primary-gray-200 rounded"></div>
            <div class="absolute bottom-4 left-4 w-12 h-px bg-primary-gray-200"></div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <ProductFeatures features={data.features} />

  <!-- Specifications -->
  <ProductSpecifications specifications={data.specifications} />

  <!-- Downloads -->
  {data.downloads.length > 0 && (
    <ProductDownloads downloads={data.downloads} />
  )}

  <!-- Applications -->
  {data.applications && data.applications.length > 0 && (
    <section class="section-padding bg-primary-gray-50">
      <div class="container-custom">
        <div class="max-w-2xl mb-12">
          <div class="flex items-center gap-3 mb-4">
            <span class="w-8 h-px bg-primary-accent"></span>
            <span class="text-primary-accent text-sm font-medium tracking-wider uppercase">Applications</span>
          </div>
          <h2 class="heading-3">
            Typical Applications
          </h2>
        </div>

        <div class="max-w-3xl">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            {data.applications.map((app) => (
              <div class="flex items-center gap-3 p-4 bg-white rounded-lg border border-primary-gray-200">
                <svg class="w-5 h-5 text-primary-accent flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
                <span class="text-sm text-primary-gray-700">{app}</span>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- CTA Section -->
  <section class="section-padding bg-primary-black text-white">
    <div class="container-custom text-center">
      <h2 class="heading-3 mb-4">
        Interested in the {data.name}?
      </h2>
      <p class="text-primary-gray-400 mb-8 max-w-2xl mx-auto">
        Contact us for pricing, technical support, or to discuss your measurement requirements.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="/contact" class="btn-primary">
          Contact Us
        </a>
        <a href="/products" class="btn-secondary border-primary-gray-600 text-primary-gray-300 hover:bg-primary-gray-600 hover:text-white">
          View All Products
        </a>
      </div>
    </div>
  </section>
</Layout>
