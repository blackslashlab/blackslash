---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="About | /blackslash/"
  description="Learn about /blackslash/ — a technology and instrumentation company focused on developing high-accuracy measurement instruments."
>
  <!-- Page Header -->
  <section class="bg-primary-gray-50 py-16 md:py-24">
    <div class="container-custom">
      <div class="max-w-3xl">
        <div class="flex items-center gap-3 mb-4">
          <span class="w-8 h-px bg-primary-accent"></span>
          <span class="text-primary-accent text-sm font-medium tracking-wider uppercase">About</span>
        </div>
        <h1 class="heading-2 mb-4">
          About /blackslash/
        </h1>
        <p class="body-large">
          A technology and instrumentation company focused on precision and innovation.
        </p>
      </div>
    </div>
  </section>

  <!-- Main Content -->
  <section class="section-padding">
    <div class="container-custom">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
        <!-- Left Column -->
        <div>
          <h2 class="heading-3 mb-6">
            The Slash of Innovation
          </h2>
          
          <div class="space-y-4 text-primary-gray-600">
            <p>
              /blackslash/ is a technology and instrumentation company focused on developing 
              high-accuracy measurement instruments and innovative electronic products.
            </p>
            <p>
              We are committed to delivering precision instruments that meet the demanding 
              requirements of professional environments — from industrial applications to 
              laboratory research.
            </p>
            <p>
              Our name represents our core philosophy: a precise, decisive approach to 
              measurement technology. Like the slash itself, we deliver accuracy with clarity.
            </p>
          </div>
          
          <div class="mt-8">
            <a href="/contact" class="btn-primary">
              Get in Touch
            </a>
          </div>
        </div>
        
        <!-- Right Column - Values -->
        <div>
          <h2 class="heading-3 mb-6">
            Our Values
          </h2>
          
          <div class="space-y-6">
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-12 h-12 bg-primary-accent/10 rounded-lg flex items-center justify-center">
                <svg class="w-6 h-6 text-primary-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold mb-1">Precision</h3>
                <p class="text-sm text-primary-gray-600">
                  Every instrument is designed with accuracy as the primary objective.
                </p>
              </div>
            </div>
            
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-12 h-12 bg-primary-accent/10 rounded-lg flex items-center justify-center">
                <svg class="w-6 h-6 text-primary-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold mb-1">Innovation</h3>
                <p class="text-sm text-primary-gray-600">
                  Continuously developing new technologies and measurement solutions.
                </p>
              </div>
            </div>
            
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-12 h-12 bg-primary-accent/10 rounded-lg flex items-center justify-center">
                <svg class="w-6 h-6 text-primary-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold mb-1">Quality</h3>
                <p class="text-sm text-primary-gray-600">
                  Building instruments that professionals can rely on day after day.
                </p>
              </div>
            </div>
            
            <div class="flex items-start gap-4">
              <div class="flex-shrink-0 w-12 h-12 bg-primary-accent/10 rounded-lg flex items-center justify-center">
                <svg class="w-6 h-6 text-primary-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
                </svg>
              </div>
              <div>
                <h3 class="font-semibold mb-1">Reliability</h3>
                <p class="text-sm text-primary-gray-600">
                  Instruments engineered for consistent performance in demanding environments.
                </p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Mission Section -->
  <section class="section-padding bg-primary-gray-50">
    <div class="container-custom text-center max-w-3xl">
      <h2 class="heading-3 mb-6">
        Our Mission
      </h2>
      <p class="text-lg text-primary-gray-600 leading-relaxed">
        To develop and deliver high-accuracy measurement instruments that enable 
        professionals across industries to achieve precise, reliable, and repeatable 
        measurements. We believe that accurate measurement is the foundation of quality, 
        safety, and innovation.
      </p>
    </div>
  </section>
</Layout>
