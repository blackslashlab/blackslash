---
interface Props {
  variant?: 'accent' | 'gray';
  class?: string;
}

const {
  variant = 'accent',
  class: className = '',
} = Astro.props;

const variants = {
  accent: 'bg-primary-accent/10 text-primary-accent',
  gray: 'bg-primary-gray-100 text-primary-gray-600',
};

const classes = `inline-flex items-center px-3 py-1 rounded-full text-sm font-medium ${variants[variant]} ${className}`;
---

<span class={classes}>
  <slot />
</span>
