---
---

<section class="section-padding bg-primary-gray-50">
  <div class="container-custom">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      <!-- Content -->
      <div>
        <div class="flex items-center gap-3 mb-4">
          <span class="w-8 h-px bg-primary-accent"></span>
          <span class="text-primary-accent text-sm font-medium tracking-wider uppercase">About Us</span>
        </div>
        
        <h2 class="heading-2 mb-6">
          Engineering Precision for Professional Environments
        </h2>
        
        <div class="space-y-4 text-primary-gray-600">
          <p>
            /blackslash/ is a technology and instrumentation company focused on developing 
            high-accuracy measurement instruments and innovative electronic products.
          </p>
          <p>
            Our mission is to deliver precision instruments that meet the demanding requirements 
            of professional environments — from industrial applications to laboratory research.
          </p>
          <p>
            We are committed to accuracy, reliability, and innovation in everything we develop.
          </p>
        </div>
        
        <div class="mt-8 flex flex-col sm:flex-row gap-4">
          <a href="/about" class="btn-primary">
            Learn More
          </a>
          <a href="/contact" class="btn-ghost">
            Contact Us
          </a>
        </div>
      </div>
      
      <!-- Visual -->
      <div class="relative">
        <div class="aspect-square bg-primary-white rounded-2xl border border-primary-gray-200 p-8 relative overflow-hidden">
          <!-- Precision-themed illustration -->
          <svg class="w-full h-full" viewBox="0 0 400 400" fill="none" xmlns="http://www.w3.org/2000/svg">
            <!-- Grid background -->
            <defs>
              <pattern id="precision-grid" width="20" height="20" patternUnits="userSpaceOnUse">
                <path d="M 20 0 L 0 0 0 20" fill="none" stroke="#E5E5E5" stroke-width="0.5"/>
              </pattern>
            </defs>
            <rect width="400" height="400" fill="url(#precision-grid)" />
            
            <!-- Measurement marks -->
            <g stroke="#E63946" stroke-width="1">
              <line x1="50" y1="200" x2="350" y2="200" stroke-dasharray="4 4" opacity="0.3"/>
              <line x1="200" y1="50" x2="200" y2="350" stroke-dasharray="4 4" opacity="0.3"/>
            </g>
            
            <!-- Central element -->
            <circle cx="200" cy="200" r="80" fill="none" stroke="#E63946" stroke-width="2" opacity="0.2"/>
            <circle cx="200" cy="200" r="60" fill="none" stroke="#E63946" stroke-width="1" opacity="0.3"/>
            <circle cx="200" cy="200" r="40" fill="none" stroke="#E63946" stroke-width="1" opacity="0.4"/>
            <circle cx="200" cy="200" r="4" fill="#E63946"/>
            
            <!-- Crosshair -->
            <line x1="180" y1="200" x2="220" y2="200" stroke="#E63946" stroke-width="2"/>
            <line x1="200" y1="180" x2="200" y2="220" stroke="#E63946" stroke-width="2"/>
            
            <!-- Decorative slash -->
            <line x1="280" y1="120" x2="320" y2="160" stroke="#E63946" stroke-width="3" stroke-linecap="round"/>
          </svg>
          
          <!-- Overlay text -->
          <div class="absolute bottom-6 left-6 right-6">
            <div class="bg-white/90 backdrop-blur-sm rounded-lg p-4 border border-primary-gray-200">
              <p class="text-sm font-medium text-primary-gray-800">Precision Engineering</p>
              <p class="text-xs text-primary-gray-500">Accuracy • Reliability • Innovation</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
