---
interface Specification {
  parameter: string;
  value: string;
}

interface Props {
  specifications: Specification[];
}

const { specifications } = Astro.props;
---

<section class="section-padding bg-primary-gray-50">
  <div class="container-custom">
    <div class="max-w-2xl mb-12">
      <div class="flex items-center gap-3 mb-4">
        <span class="w-8 h-px bg-primary-accent"></span>
        <span class="text-primary-accent text-sm font-medium tracking-wider uppercase">Specifications</span>
      </div>
      <h2 class="heading-3">
        Technical Specifications
      </h2>
    </div>

    <div class="max-w-3xl">
      <div class="bg-white rounded-xl border border-primary-gray-200 overflow-hidden">
        <table class="w-full">
          <thead>
            <tr class="bg-primary-gray-50 border-b border-primary-gray-200">
              <th class="text-left px-6 py-4 text-sm font-semibold text-primary-gray-800">Parameter</th>
              <th class="text-left px-6 py-4 text-sm font-semibold text-primary-gray-800">Specification</th>
            </tr>
          </thead>
          <tbody>
            {specifications.map((spec, index) => (
              <tr class={`border-b border-primary-gray-100 last:border-0 ${index % 2 === 0 ? 'bg-white' : 'bg-primary-gray-50/50'}`}>
                <td class="px-6 py-4 text-sm font-medium text-primary-gray-700">{spec.parameter}</td>
                <td class="px-6 py-4 text-sm text-primary-gray-600">
                  {spec.value.includes('[To be provided]') ? (
                    <span class="text-primary-gray-400 italic">{spec.value}</span>
                  ) : (
                    spec.value
                  )}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>
</section>
