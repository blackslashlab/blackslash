---
interface Feature {
  title: string;
  description: string;
  icon?: string;
}

interface Props {
  features: Feature[];
}

const { features } = Astro.props;

const iconMap: Record<string, string> = {
  accuracy: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z',
  range: 'M13 10V3L4 14h7v7l9-11h-7z',
  display: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
  design: 'M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z',
  default: 'M5 13l4 4L19 7',
};
---

<section class="section-padding bg-primary-white">
  <div class="container-custom">
    <div class="max-w-2xl mb-12">
      <div class="flex items-center gap-3 mb-4">
        <span class="w-8 h-px bg-primary-accent"></span>
        <span class="text-primary-accent text-sm font-medium tracking-wider uppercase">Features</span>
      </div>
      <h2 class="heading-3">
        Key Features
      </h2>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {features.map((feature) => {
        const iconPath = iconMap[feature.icon || 'default'] || iconMap.default;
        return (
          <div class="flex items-start gap-4 p-6 bg-primary-gray-50 rounded-xl border border-primary-gray-100 hover:border-primary-gray-200 transition-colors">
            <div class="flex-shrink-0 w-12 h-12 bg-primary-accent/10 rounded-lg flex items-center justify-center">
              <svg class="w-6 h-6 text-primary-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={iconPath} />
              </svg>
            </div>
            <div>
              <h3 class="font-semibold mb-1">{feature.title}</h3>
              <p class="text-sm text-primary-gray-600">{feature.description}</p>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</section>
